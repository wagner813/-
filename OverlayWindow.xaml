<Window x:Class="GameCursorTranslator.OverlayWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="520" Height="54" SizeToContent="Height"
 WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
 Topmost="True" ShowActivated="False">
 <Border Background="#E91B2430" CornerRadius="9" Padding="13,8"
         BorderBrush="#66FFFFFF" BorderThickness="1">
  <StackPanel>
   <TextBlock x:Name="TranslationText" Foreground="White" FontSize="19"
              FontWeight="SemiBold" TextAlignment="Center"
              TextWrapping="Wrap" MaxWidth="490"/>
   <TextBlock x:Name="OriginalText" Foreground="#B9C7D8" FontSize="10"
              TextAlignment="Center" TextWrapping="Wrap" MaxWidth="490"/>
  </StackPanel>
 </Border>
</Window>
