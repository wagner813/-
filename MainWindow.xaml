<Window x:Class="GameCursorTranslator.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="游戏光标翻译助手" Height="490" Width="650"
 WindowStartupLocation="CenterScreen" Background="#F3F5F8">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="游戏光标翻译助手" FontSize="25" FontWeight="Bold" Foreground="#182230"/>
   <TextBlock Text="Windows 11 内置 OCR · 鼠标悬停取词 · 英译中" Margin="0,7,0,0" Foreground="#637083"/>
  </StackPanel>
  <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="20" Margin="0,22,0,18">
   <StackPanel>
    <TextBlock Text="运行控制" FontSize="17" FontWeight="SemiBold"/>
    <WrapPanel Margin="0,15,0,8">
     <Button x:Name="StartButton" Content="开始取词  (F8)" Width="145" Height="38" Margin="0,0,10,0" Click="Start_Click"/>
     <Button x:Name="PauseButton" Content="暂停 / 恢复  (F9)" Width="145" Height="38" Click="Pause_Click"/>
    </WrapPanel>
    <TextBlock x:Name="StatusText" Text="状态：未启动" Margin="0,7,0,15" Foreground="#2563EB"/>
    <Separator/>
    <TextBlock Text="工作方式" FontWeight="SemiBold" Margin="0,14,0,7"/>
    <TextBlock Text="1. 将鼠标停在游戏中的英文单词上约 0.3 秒。&#10;2. 程序截取光标附近的小区域，调用 Windows.Media.Ocr 识别。&#10;3. 只提取光标所在的单词，并在光标上方显示中文。&#10;4. 移开文字后，译文自动隐藏。" TextWrapping="Wrap" LineHeight="24" Foreground="#465365"/>
    <Border Background="#FFF7E8" CornerRadius="8" Padding="11" Margin="0,16,0,0">
     <TextBlock Text="注意：首次使用需安装 Windows 英语 OCR 语言包并保持网络连接。在线翻译使用 MyMemory 公共接口；该接口有使用频率限制。独占全屏、受保护画面或反作弊限制可能无法截屏识别。" TextWrapping="Wrap" Foreground="#8A5A12"/>
    </Border>
   </StackPanel>
  </Border>
  <TextBlock Grid.Row="2" Text="快捷键：F8 开始/停止　 F9 暂停/恢复　 Esc 退出" Foreground="#64748B" HorizontalAlignment="Center"/>
 </Grid>
</Window>
